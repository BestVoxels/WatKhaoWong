  m_TableData:
  - m_Id: 8865701888
    m_Localized: "\u0E04\u0E31\u0E14\u0E25\u0E2D\u0E01 \u0E40\u0E25\u0E02\u0E17\u0E35\u0E48\u0E1A\u0E31\u0E0D\u0E0A\u0E35\u0E18\u0E19\u0E32\u0E04\u0E32\u0E23"
    m_Metadata:
      m_Items: []
  - m_Id: 41459624435712
    m_Localized: "\u0E1A\u0E31\u0E0D\u0E0A\u0E35\u0E23\u0E48\u0E27\u0E21\u0E1A\u0E38\u0E0D\u0E41\u0E22\u0E01\u0E1B\u0E23\u0E30\u0E40\u0E20\u0E17
      \u0E02\u0E2D\u0E07\n\u0E27\u0E31\u0E14\u0E40\u0E02\u0E32\u0E27\u0E07 (\u0E16\u0E49\u0E33\u0E19\u0E32\u0E23\u0E32\u0E22\u0E13\u0E4C)"
    m_Metadata:
      m_Items: []
  - m_Id: 41533645512704
    m_Localized: "\u0E17\u0E48\u0E32\u0E19\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E23\u0E48\u0E27\u0E21\u0E1A\u0E38\u0E0D\u0E01\u0E31\u0E1A\u0E17\u0E32\u0E07\u0E27\u0E31\u0E14
      \u0E44\u0E14\u0E49\u0E15\u0E32\u0E21\u0E04\u0E27\u0E32\u0E21\u0E1B\u0E23\u0E30\u0E2A\u0E07\u0E04\u0E4C
      \u0E41\u0E25\u0E30\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E30\u0E14\u0E27\u0E01
      \u0E43\u0E19\u0E01\u0E32\u0E23\u0E01\u0E23\u0E2D\u0E01\u0E40\u0E25\u0E02\u0E1A\u0E31\u0E0D\u0E0A\u0E35
      '\u0E01\u0E14\u0E1B\u0E38\u0E48\u0E21\u0E2A\u0E35\u0E40\u0E02\u0E35\u0E22\u0E27'
      \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E04\u0E31\u0E14\u0E25\u0E2D\u0E01\u0E40\u0E25\u0E02\u0E1A\u0E31\u0E0D\u0E0A\u0E35\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22
      \n\u0E02\u0E2D\u0E42\u0E21\u0E17\u0E19\u0E32\u0E1A\u0E38\u0E0D\u0E14\u0E49\u0E27\u0E22\u0E04\u0E23\u0E31\u0E1A
      ^^"
    m_Metadata:
      m_Items: []
  - m_Id: 45587566157824
    m_Localized: "\u0E18\u0E19\u0E32\u0E04\u0E32\u0E23\u0E44\u0E17\u0E22\u0E1E\u0E32\u0E13\u0E34\u0E0A\u0E22\u0E4C"
    m_Metadata:
      m_Items: []
  - m_Id: 46133387714560
    m_Localized: "\u2022 \u0E01\u0E48\u0E2D\u0E2A\u0E23\u0E49\u0E32\u0E07, \u0E1A\u0E39\u0E23\u0E13\u0E1B\u0E0F\u0E34\u0E2A\u0E31\u0E07\u0E02\u0E23\u0E13\u0E4C\u0E16\u0E32\u0E27\u0E23\u0E27\u0E31\u0E15\u0E16\u0E38"
    m_Metadata:
      m_Items: []
  - m_Id: 46096121323520
    m_Localized: "\u0E18\u0E19\u0E32\u0E04\u0E32\u0E23\u0E01\u0E23\u0E38\u0E07\u0E44\u0E17\u0E22"
    m_Metadata:
      m_Items: []
  - m_Id: 46068300505088
    m_Localized: "\u0E18\u0E19\u0E32\u0E04\u0E32\u0E23\u0E01\u0E23\u0E38\u0E07\u0E40\u0E17\u0E1E"
    m_Metadata:
      m_Items: []
  - m_Id: 49607726850048
    m_Localized: "\u2022 \u0E07\u0E32\u0E19\u0E40\u0E1C\u0E22\u0E41\u0E1C\u0E48,
      \u0E2A\u0E37\u0E1A\u0E2D\u0E32\u0E22\u0E38\u0E1E\u0E23\u0E30\u0E1E\u0E38\u0E17\u0E18\u0E28\u0E32\u0E2A\u0E19\u0E32"
    m_Metadata:
      m_Items: []
  - m_Id: 49882587979776
    m_Localized: "\u2022 \u0E08\u0E2D\u0E07\u0E1A\u0E39\u0E0A\u0E32, \u0E08\u0E31\u0E14\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E27\u0E31\u0E15\u0E16\u0E38\u0E21\u0E07\u0E04\u0E25"
    m_Metadata:
      m_Items: []
  - m_Id: 51048927453184
    m_Localized: "\u2022 \u0E2A\u0E31\u0E07\u0E06\u0E17\u0E32\u0E19, \u0E17\u0E33\u0E1A\u0E38\u0E0D\u0E17\u0E38\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B"
    m_Metadata:
      m_Items: []
  - m_Id: 56771908460544
    m_Localized: "\u2022 \u0E04\u0E48\u0E32\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E1E\u0E23\u0E30\u0E41\u0E25\u0E30\u0E1C\u0E39\u0E49\u0E21\u0E32\u0E1B\u0E0F\u0E34\u0E1A\u0E31\u0E15\u0E34\u0E18\u0E23\u0E23\u0E21"
    m_Metadata:
      m_Items: []
  - m_Id: 57543945609216
    m_Localized: "\u2022 \u0E04\u0E48\u0E32\u0E23\u0E31\u0E01\u0E29\u0E32\u0E1E\u0E22\u0E32\u0E1A\u0E32\u0E25\u0E1E\u0E23\u0E30\u0E20\u0E34\u0E01\u0E29\u0E38\u0E44\u0E02\u0E49"
    m_Metadata:
      m_Items: []
  - m_Id: 57560043347968
    m_Localized: "\u2022 \u0E16\u0E27\u0E32\u0E22\u0E1B\u0E31\u0E08\u0E08\u0E31\u0E22\u0E2A\u0E48\u0E27\u0E19\u0E2D\u0E07\u0E04\u0E4C\u0E2B\u0E25\u0E27\u0E07\u0E15\u0E32"
    m_Metadata:
      m_Items: []
  - m_Id: 50038796443648
    m_Localized: "\u2022 \u0E40\u0E08\u0E49\u0E32\u0E20\u0E32\u0E1E\u0E1A\u0E27\u0E0A\u0E1E\u0E23\u0E30\u0E1C\u0E39\u0E49\u0E44\u0E21\u0E48\u0E21\u0E35\u0E17\u0E38\u0E19\u0E1A\u0E27\u0E0A"
    m_Metadata:
      m_Items: []
  - m_Id: 51011073859584
    m_Localized: "\u2022 \u0E40\u0E25\u0E35\u0E49\u0E22\u0E07\u0E42\u0E23\u0E07\u0E17\u0E32\u0E19\u0E07\u0E32\u0E19\u0E1A\u0E38\u0E0D\u0E15\u0E48\u0E32\u0E07
      \u0E46"
    m_Metadata:
      m_Items: []
  - m_Id: 51019688960000
    m_Localized: "\u2022 \u0E0A\u0E48\u0E27\u0E22\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E41\u0E25\u0E30\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E0A\u0E35\u0E27\u0E34\u0E15\u0E2A\u0E31\u0E15\u0E27\u0E4C"
    m_Metadata:
      m_Items: []
  - m_Id: 51029298110464
    m_Localized: "\u2022 \u0E21\u0E2B\u0E32\u0E2A\u0E31\u0E07\u0E06\u0E17\u0E32\u0E19\u0E40\u0E09\u0E1E\u0E32\u0E30\u0E01\u0E10\u0E34\u0E19\u0E01\u0E32\u0E25"
    m_Metadata:
