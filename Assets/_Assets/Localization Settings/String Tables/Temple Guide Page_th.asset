    m_Localized: "\u0E51. \u0E40\u0E21\u0E37\u0E48\u0E2D\u0E08\u0E30\u0E2D\u0E2D\u0E01\u0E44\u0E1B\u0E19\u0E2D\u0E01\u0E1A\u0E23\u0E34\u0E40\u0E27\u0E13\u0E27\u0E31\u0E14
