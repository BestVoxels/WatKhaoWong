  m_TableData:
  - m_Id: 6168764416
    m_Localized: CREDITS
    m_Metadata:
      m_Items: []
  - m_Id: 142328455168
    m_Localized: "<u>\u0E1B\u0E23\u0E30\u0E18\u0E32\u0E19\u0E04\u0E13\u0E30\u0E2A\u0E07\u0E06\u0E4C</u>\n\n\u0E1E\u0E23\u0E30\u0E23\u0E32\u0E0A\u0E20\u0E32\u0E27\u0E19\u0E32\u0E1E\u0E31\u0E0A\u0E23\u0E0D\u0E32\u0E13
      \u0E27\u0E34\u0E1B\u0E31\u0E2A\u0E2A\u0E19\u0E32\u0E27\u0E34\u0E18\u0E32\u0E19\u0E18\u0E38\u0E23\u0E32\u0E17\u0E23
      \u0E21\u0E2B\u0E32\u0E04\u0E13\u0E34\u0E2A\u0E2A\u0E23 \u0E1A\u0E27\u0E23\u0E2A\u0E31\u0E07\u0E06\u0E32\u0E23\u0E32\u0E21
      \u0E04\u0E32\u0E21\u0E27\u0E32\u0E2A\u0E35"
    m_Metadata:
      m_Items: []
  - m_Id: 3516813795328
    m_Localized: Buddhism
    m_Metadata:
      m_Items: []
  - m_Id: 29053326188544
    m_Localized: 'System Architect:

      Designed the architecture, including real-time
      database integration using Firebase with advanced optimization techniques like
      JSON tree flattening for optimal performance.'
    m_Metadata:
      m_Items: []
  - m_Id: 29132132966400
    m_Localized: 'Senior Programmer:

      Developed core features using advanced
      programming patterns and principles, including MVP, my custom MVPR (a modular
      UI management technique), Object Pooling for efficient memory use, Singleton
      for global state management, and Observer for event-driven behavior. Emphasized
      "composition over inheritance" for flexible and maintainable code. Also optimized
      code with LINQ for efficient data querying and manipulation, ensuring high
      performance across the application.'
    m_Metadata:
      m_Items: []
  - m_Id: 29137845608448
    m_Localized: 'UX/UI Designer:

      Crafted an intuitive user experience with
      attention to detail, including animations like shrink/expand on button interactions,
      crisp text, and overall fluid design. Additionally optimized for high-refresh-rate
      displays, supporting up to 120Hz or more for devices that can handle it.'
    m_Metadata:
      m_Items: []
  - m_Id: 29144342585344
    m_Localized: 'Visual Designer:

      Created initial sketches and prototypes
      for all pages, ensuring a cohesive design that balances aesthetics and usability
      across different devices.'
    m_Metadata:
      m_Items: []
